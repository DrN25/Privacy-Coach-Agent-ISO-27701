  "cards": [
    {
      "title": "El Embudo Quirúrgico de 4 Etapas (150k -> 850 tokens)",
      "dot": "violet",
      "items": [
        "Etapa 1: Filtro por Rol (60 controles aplicables en 0.0001s)",
        "Etapa 2: Motor DSPM AST evalúa reglas booleanas de privacidad",
        "Etapa 3: Extracción de Subgrafo NetworkX (0.2 ms, cero tokens)",
        "Etapa 4: Búsqueda facetada de sanciones ANPD por artículo de ley",
        "Inyección al Coach: Payload limpio de apenas 850 tokens"
      ]
    },
    {
      "title": "Los 3 Candados Anti-Falla del Profiler Semántico",
      "dot": "cyan",
      "items": [
        "Candado 1: Taxonomía Canónica Cerrada (8 Enums de Ley 29733 Art. 2.5)",
        "Candado 2: Structured Outputs Pydantic con Gramáticas GBNF (logits forzados)",
        "Candado 3: Cascada en 3 Capas: Regex rápido -> LLM Pydantic -> Human-in-the-loop"
      ]
    },
    {
      "title": "Router O(1) Regla-a-Grafo: CERO LLM",
      "dot": "emerald",
      "items": [
        "Entre la detección del DSPM y la extracción ISO NO HAY LLM",
        "Diccionario estático resuelve la correspondencia en 0.0002 segundos",
        "Garantiza el 100% de eliminación de alucinaciones normativas",
        "El LLM solo actúa al final en el rol de Coach Pedagógico"
      ]
    },
    {
      "title": "Dossier Documental del Coordinador de Privacidad",
      "dot": "amber",
      "items": [
        "1. Registro RoPA e inscripción en el Registro Nacional ANPD (Art. 31)",
        "2. Políticas de privacidad y avisos informativos visibles (Art. 18)",
        "3. Procedimiento y bitácora de atención de derechos ARCO (Arts. 19-24)",
        "4. Evaluaciones de Impacto PIA/EIPD para datos de salud y biométricos",
        "5. Contratos de encargo DPA con proveedores de software y nube",
        "6. Política de conservación y protocolo de borrado seguro de datos",
        "7. Plan de respuesta y notificación de brechas de seguridad (Art. 41)",
        "8. Acuerdos de confidencialidad (NDA) y capacitaciones anuales al personal"
      ]
    }
  ]
