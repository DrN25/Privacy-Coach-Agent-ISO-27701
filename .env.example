# ==============================================================================
# PRIVACY COACH & DSPM ENGINE (ISO/IEC 27701:2025 & LEY 29733)
# Plantilla de Variables de Entorno (Pública - Seguro para versionar en Git)
# ==============================================================================

# Clave de API de OpenRouter (Obtén la tuya en https://openrouter.ai/keys)
OPENROUTER_API_KEY=tu_clave_openrouter_aqui

# Configuración del Modelo LLM de Inferencia
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Configuración del Servidor
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Persistencia y CORS. En Render, DATABASE_PATH debe apuntar al disco montado.
DATABASE_PATH=src/data/empresa_conocimiento.db
CORS_ORIGINS=*

# Obligatorios cuando ENVIRONMENT=production. Protegen UI y API mediante HTTP Basic.
APP_USERNAME=admin
APP_PASSWORD=cambia_esta_contrasena
