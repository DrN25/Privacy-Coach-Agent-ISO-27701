# ==============================================================================
# PRIVACY COACH & DSPM ENGINE (ISO/IEC 27701:2025 & LEY 29733)
# Plantilla de Variables de Entorno (Pblica - Seguro para versionar en Git)
# ==============================================================================

# 1. Inferencia LLM (OpenRouter / GPT-6 Luna)
OPENROUTER_API_KEY=tu_clave_openrouter_aqui
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# 2. Configuracin del Servidor y Entorno
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# 3. Autenticacin HTTP Basic (OBLIGATORIA si ENVIRONMENT=production)
APP_USERNAME=admin
APP_PASSWORD=cambia_esta_contrasena_segura

# 4. Persistencia Local (SQLite Fallback)
# En Docker/VPS montado en volumen: /var/data/empresa_conocimiento.db
DATABASE_PATH=src/data/empresa_conocimiento.db
CORS_ORIGINS=*

# 5. Base de Datos Institucional PostgreSQL (Opcional - unsa_pims_db)
# Si no est disponible o PG_ENABLED=false, opera automticamente en modo SQLite
PG_ENABLED=false
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=unsa_pims_db
PG_USER=postgres
PG_PASSWORD=tu_password_postgres
PG_SCHEMA=demo

# 6. Agente Institucional UNSA A2A (Opcional)
UNSA_A2A_ENABLED=false
UNSA_A2A_URL=http://localhost:8001/a2a
UNSA_A2A_API_KEY=
