# Autenticación HTTP Basic de toda la interfaz y API.
APP_USERNAME=admin
APP_PASSWORD=genera_una_contrasena_larga_y_unica

# OpenRouter.
OPENROUTER_API_KEY=tu_token_openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Origen permitido del proxy o frontend que accederá a la API.
CORS_ORIGINS=https://privacy.example.com
