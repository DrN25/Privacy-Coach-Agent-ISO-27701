# ==============================================================================
# Git Ignore - Privacy Coach & DSPM Multi-Agent System
# ==============================================================================

# Variables de entorno y secretos (NUNCA SUBIR A GIT)
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.token

# Python bytecode y caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Caches y entornos de prueba
.pytest_cache/
.coverage
htmlcov/
.cache/

# Entornos virtuales
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs y Editores de código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Bases de datos temporales / locks locales
*.sqlite3-journal
*.db-journal
*.bak
*.checkpoint.bak
src/data/evidencias_uploads/

# Documentos PDF pesados / protegidos por derechos de autor (ISO OCR 14.7MB)
# (Los grafos y datasets estructurados en .json de Material/ SÍ se versionan)
knowledge_base/**/*.pdf
knowledge_base/*.pdf

# Archivos de log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Understand-Anything intermediate y temporales
.ua/intermediate/
.ua/tmp/

# Carpeta local para subida a Google Drive (documentos fuente PDF)
fuentes_normativas_pdf/

# Dependencias Node.js
node_modules/
**/node_modules/

# Otros / Archivos residuales y borradores locales
/temp/
/scratch/
BD.zip
skills-lock.json
test_chat_flow.py
verify_all_chat_features.py
issues.md
pendiente-conexion.md
contenido.md
Funcionalidades_Sistema.md
docs/INVESTIGACION_ESTADO_DEL_ARTE_Y_ALCANCE_SISTEMA.md
.agents/skills/design-taste-frontend/
.agents/skills/frontend-design/
.agents/skills/impeccable/